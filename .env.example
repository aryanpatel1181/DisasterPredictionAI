# TerraGuard AI Environment Configuration

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=terraguard_secret_key_change_in_production_32bytes

# API Server
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# PostgreSQL / PostGIS Database
POSTGRES_USER=terraguard
POSTGRES_PASSWORD=terraguard_dev_pass
POSTGRES_DB=terraguard_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://terraguard:terraguard_dev_pass@localhost:5432/terraguard_db

# Redis Cache & Worker Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# External Data Provider Credentials & Configs (Optional - dev/mock adapters activate if missing)
USGS_API_URL=https://earthquake.usgs.gov/fdsnws/event/1/
GDACS_API_URL=https://www.gdacs.org/xml/rss.xml
NASA_EARTHDATA_TOKEN=
COPERNICUS_CDS_API_KEY=
WMO_CAP_FEED_URL=https://alert.worldweather.wmo.int/

# Model Registry Configuration
MODEL_REGISTRY_PATH=./ml/registry

# AI Chatbot (OpenRouter) Configuration
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
